	partition Parks = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("tables/parks.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"unit_code", "name", "state", "group", "roads_source", "area_km2", "core_km2", "core_share_pct", "visits_2025", "peak_month", "per_day_park_2025", "per_day_core_2025", "core_vs_park", "lat", "lng"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"unit_code", type text}, {"name", type text}, {"state", type text}, {"group", type text}, {"roads_source", type text}, {"area_km2", type number}, {"core_km2", type number}, {"core_share_pct", type number}, {"visits_2025", Int64.Type}, {"peak_month", type text}, {"per_day_park_2025", type number}, {"per_day_core_2025", type number}, {"core_vs_park", type number}, {"lat", type number}, {"lng", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
