table Parks
	lineageTag: 6e45d6d6-a4b7-a568-3e8a-7ee0a60d86a9

	measure 'Park count' = COUNTROWS ( Parks )
		formatString: #,0
		lineageTag: dee6f9ac-6ec3-8001-3a12-4227f9591627

	/// Recreation visits in 2025
	measure Visits = SUM ( Parks[visits_2025] )
		formatString: #,0
		lineageTag: 3071c54b-57d5-90e9-3313-a05005350af3

	/// 2025 visits over the parks' area and 365 days
	measure 'Visits per km2 of park a day' = DIVIDE ( SUM ( Parks[visits_2025] ), SUM ( Parks[area_km2] ) * 365 )
		formatString: #,0.0
		lineageTag: 39cf8653-5510-825e-5914-a366e505f8de

	/// 2025 visits over the visitor cores' area and 365 days
	measure 'Visits per km2 of core a day' = DIVIDE ( SUM ( Parks[visits_2025] ), SUM ( Parks[core_km2] ) * 365 )
		formatString: #,0
		lineageTag: 19b3103e-48f4-7138-50b8-b097d4fd5d37

	/// How many times the core's density is the whole park's
	measure 'Times denser' = DIVIDE ( [Visits per km2 of core a day], [Visits per km2 of park a day] )
		formatString: #,0.0
		lineageTag: 2021c809-8dbf-863f-c23e-f252ab29d76e

	column unit_code
		dataType: string
		lineageTag: 4c1fa7f3-fd7f-a448-e27f-7bf81b2f3e4d
